<?xml version="1.0" encoding="utf-8"?>
<!-- One scrolling column: header, status, then one card per setup step.
     MainActivity shows the cards that fit the current state. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/fg"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Telemedia.Text"
            android:layout_marginTop="2dp"
            android:text="@string/tagline" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/fg"
            android:textSize="17sp" />

        <!-- Step 1: Telegram login -->
        <LinearLayout
            android:id="@+id/login_card"
            style="@style/Telemedia.Card">

            <TextView
                style="@style/Telemedia.CardTitle"
                android:text="@string/login_title" />

            <TextView
                style="@style/Telemedia.Text"
                android:text="@string/login_intro" />

            <Button
                android:id="@+id/login_link"
                style="@style/Telemedia.Button.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/login_link" />

            <TextView
                android:id="@+id/login_link_hint"
                style="@style/Telemedia.Text"
                android:text="@string/login_link_hint" />

            <Button
                android:id="@+id/login_use_phone"
                style="@style/Telemedia.Button.Secondary"
                android:text="@string/login_use_phone" />

            <LinearLayout
                android:id="@+id/phone_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/phone"
                    style="@style/Telemedia.Field"
                    android:hint="@string/phone_hint"
                    android:imeOptions="actionSend"
                    android:inputType="phone" />

                <Button
                    android:id="@+id/send_phone"
                    style="@style/Telemedia.Button.Primary"
                    android:text="@string/send_code" />

                <LinearLayout
                    android:id="@+id/code_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/code_text"
                        style="@style/Telemedia.Text"
                        android:text="@string/code_sent_app" />

                    <EditText
                        android:id="@+id/code"
                        style="@style/Telemedia.Field"
                        android:hint="@string/code_hint"
                        android:imeOptions="actionDone"
                        android:inputType="number" />

                    <Button
                        android:id="@+id/send_code"
                        style="@style/Telemedia.Button.Primary"
                        android:text="@string/log_in" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/login_error"
                style="@style/Telemedia.Error" />
        </LinearLayout>

        <!-- Two-step verification password -->
        <LinearLayout
            android:id="@+id/password_card"
            style="@style/Telemedia.Card">

            <TextView
                style="@style/Telemedia.CardTitle"
                android:text="@string/password_title" />

            <TextView
                android:id="@+id/password_text"
                style="@style/Telemedia.Text"
                android:text="@string/password_intro" />

            <EditText
                android:id="@+id/password"
                style="@style/Telemedia.Field"
                android:hint="@string/password_hint"
                android:imeOptions="actionDone"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/send_password"
                style="@style/Telemedia.Button.Primary"
                android:text="@string/continue_button" />

            <TextView
                android:id="@+id/password_error"
                style="@style/Telemedia.Error" />
        </LinearLayout>

        <!-- Fallback: own API key by hand -->
        <LinearLayout
            android:id="@+id/config_card"
            style="@style/Telemedia.Card">

            <TextView
                style="@style/Telemedia.CardTitle"
                android:text="@string/config_title" />

            <TextView
                style="@style/Telemedia.Text"
                android:text="@string/config_intro" />

            <EditText
                android:id="@+id/config_phone"
                style="@style/Telemedia.Field"
                android:hint="@string/phone_hint"
                android:inputType="phone" />

            <Button
                android:id="@+id/config_send_phone"
                style="@style/Telemedia.Button.Primary"
                android:text="@string/send_code" />

            <LinearLayout
                android:id="@+id/config_code_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Telemedia.Text"
                    android:text="@string/config_code_sent" />

                <EditText
                    android:id="@+id/config_code"
                    style="@style/Telemedia.Field"
                    android:hint="@string/config_code_hint"
                    android:inputType="textNoSuggestions|textVisiblePassword" />

                <Button
                    android:id="@+id/config_send_code"
                    style="@style/Telemedia.Button.Primary"
                    android:text="@string/continue_button" />
            </LinearLayout>

            <Button
                android:id="@+id/config_manual_toggle"
                style="@style/Telemedia.Button.Secondary"
                android:layout_marginTop="20dp"
                android:text="@string/config_manual" />

            <LinearLayout
                android:id="@+id/config_manual_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/api_id"
                    style="@style/Telemedia.Field"
                    android:hint="@string/api_id_hint"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/api_hash"
                    style="@style/Telemedia.Field"
                    android:hint="@string/api_hash_hint"
                    android:inputType="textNoSuggestions|textVisiblePassword" />

                <Button
                    android:id="@+id/save_keys"
                    style="@style/Telemedia.Button.Primary"
                    android:text="@string/save" />
            </LinearLayout>

            <TextView
                android:id="@+id/config_error"
                style="@style/Telemedia.Error" />
        </LinearLayout>

        <!-- Step 2: head-start groups -->
        <LinearLayout
            android:id="@+id/groups_card"
            style="@style/Telemedia.Card">

            <TextView
                style="@style/Telemedia.CardTitle"
                android:text="@string/groups_title" />

            <TextView
                style="@style/Telemedia.Text"
                android:text="@string/groups_intro" />

            <LinearLayout
                android:id="@+id/groups_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/groups_join"
                style="@style/Telemedia.Button.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/groups_join" />

            <Button
                android:id="@+id/groups_skip"
                style="@style/Telemedia.Button.Secondary"
                android:text="@string/groups_skip" />

            <TextView
                android:id="@+id/groups_error"
                style="@style/Telemedia.Error" />
        </LinearLayout>

        <!-- Step 3: Stremio -->
        <LinearLayout
            android:id="@+id/stremio_card"
            style="@style/Telemedia.Card">

            <TextView
                style="@style/Telemedia.CardTitle"
                android:text="@string/stremio_title" />

            <TextView
                style="@style/Telemedia.Text"
                android:text="@string/stremio_intro" />

            <Button
                android:id="@+id/stremio_add"
                style="@style/Telemedia.Button.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/stremio_add" />

            <TextView
                android:id="@+id/stremio_note"
                style="@style/Telemedia.Text"
                android:visibility="gone" />

            <Button
                android:id="@+id/stremio_get"
                style="@style/Telemedia.Button.Secondary"
                android:text="@string/get_stremio"
                android:visibility="gone" />

            <TextView
                android:id="@+id/stremio_error"
                style="@style/Telemedia.Error" />
        </LinearLayout>

        <!-- Done -->
        <LinearLayout
            android:id="@+id/done_card"
            style="@style/Telemedia.Card">

            <TextView
                style="@style/Telemedia.CardTitle"
                android:text="@string/done_title" />

            <TextView
                android:id="@+id/done_text"
                style="@style/Telemedia.Text"
                android:text="@string/done_text" />

            <Button
                android:id="@+id/open_stremio"
                style="@style/Telemedia.Button.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/open_stremio" />

            <Button
                android:id="@+id/show_groups"
                style="@style/Telemedia.Button.Secondary"
                android:text="@string/groups_show"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Other devices on the Wi-Fi (the LAN address with the personal key) -->
        <LinearLayout
            android:id="@+id/lan_card"
            style="@style/Telemedia.Card">

            <TextView
                style="@style/Telemedia.CardTitle"
                android:text="@string/lan_title" />

            <TextView
                style="@style/Telemedia.Text"
                android:text="@string/lan_intro" />

            <ImageView
                android:id="@+id/lan_qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:contentDescription="@string/lan_qr_description"
                android:padding="8dp" />

            <TextView
                android:id="@+id/lan_url"
                style="@style/Telemedia.Text"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textColor="@color/fg"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/lan_add"
                style="@style/Telemedia.Button.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/lan_add" />

            <Button
                android:id="@+id/lan_copy"
                style="@style/Telemedia.Button.Secondary"
                android:text="@string/lan_copy" />

            <TextView
                android:id="@+id/lan_note"
                style="@style/Telemedia.Text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lan_error"
                style="@style/Telemedia.Error" />
        </LinearLayout>

        <!-- Battery optimization (asked once, offered here if declined) -->
        <LinearLayout
            android:id="@+id/battery_card"
            style="@style/Telemedia.Card">

            <TextView
                style="@style/Telemedia.Text"
                android:layout_marginTop="0dp"
                android:text="@string/battery_text" />

            <Button
                android:id="@+id/battery_allow"
                style="@style/Telemedia.Button.Secondary"
                android:text="@string/battery_allow" />
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/restart"
                style="@style/Telemedia.Button.Secondary"
                android:text="@string/restart" />

            <Button
                android:id="@+id/logout"
                style="@style/Telemedia.Button.Secondary"
                android:text="@string/logout" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
